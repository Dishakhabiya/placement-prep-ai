# PlacementPrep AI Mobile Environment Configuration Example
# Copy this file to .env in the mobile/ directory if you need to override the backend API URL.

# For iOS Simulator / Web:
# EXPO_PUBLIC_API_URL=http://localhost:8000

# For Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# For Physical Device (replace with your local Wi-Fi IP address):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
